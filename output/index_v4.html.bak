<text x="90" y="208" font-family="Noto Serif JP" font-size="14" fill="#CC1400" text-anchor="middle" font-weight="700">IN</text>
<text x="90" y="230" font-family="Noto Sans JP" font-size="10" fill="#121212" text-anchor="middle">38</text>
