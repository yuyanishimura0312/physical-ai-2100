<!DOCTYPE html>
<html lang="ja" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>フィジカルAIが拓く2100年 ── 知性が物質と出会う74年の道程</title>
<link rel="icon" href="https://esse-sense.com/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #FFFFFF; --card: #FFFFFF;
  --accent: #121212;
  --accent-warm: #CC1400; --accent-warm-soft: #B01200;
  --accent-muted: rgba(204,20,0,0.06);
  --text: #121212; --text-secondary: #555555; --text-muted: #6B6B6B;
  --border: #D9D9D9; --border-light: #EEEEEE;
  --highlight: #CC1400; --surface: #F7F7F5;
  --font: "Noto Sans JP", "Hiragino Sans", -apple-system, sans-serif;
  --font-serif: "Noto Serif JP", "Hiragino Mincho ProN", Georgia, serif;
}
[data-theme="dark"] .top-bar { border-top-color: #E0E0E0; }
[data-theme="dark"] {
  --bg: #121212; --card: #1A1A1A;
  --accent: #E0E0E0;
  --accent-warm: #FF4030; --accent-warm-soft: #E03020;
  --accent-muted: rgba(255,64,48,0.10);
  --text: #E0E0E0; --text-secondary: #AAAAAA; --text-muted: #8A8A8A;
  --border: #333333; --border-light: #2A2A2A;
  --highlight: #FF4030; --surface: #1A1A1A;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body { font-family: var(--font-serif); color: var(--text); background: var(--bg); line-height: 1.95; letter-spacing: 0.025em; font-feature-settings: "palt"; min-height: 100vh; transition: background 0.2s, color 0.2s; }
a { color: var(--accent-warm); text-decoration: none; }
a:hover { text-decoration: underline; }
.top-bar { background: var(--bg); border-top: 3px solid #121212; border-bottom: 1px solid var(--border); padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 48px; position: sticky; top: 0; z-index: 100; }
.top-bar-brand { font-family: var(--font); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
.top-bar-brand span { color: var(--accent-warm); }
.top-bar-actions { display: flex; align-items: center; gap: 12px; }
.theme-toggle { background: none; border: 1px solid var(--border); color: var(--text-muted); cursor: pointer; padding: 4px 10px; font-size: 0.72rem; font-family: var(--font); letter-spacing: 0.05em; }
.theme-toggle:hover { border-color: var(--accent-warm); color: var(--accent-warm); }

.book-cover { max-width: 760px; margin: 0 auto; padding: 96px 24px 72px; text-align: center; border-bottom: 1px solid var(--border); }
.book-cover-tag { font-family: var(--font); font-size: 0.7rem; letter-spacing: 0.18em; color: var(--accent-warm); text-transform: uppercase; margin-bottom: 24px; }
.book-cover-title { font-family: var(--font-serif); font-size: 2.8rem; font-weight: 900; line-height: 1.3; letter-spacing: 0.02em; color: var(--text); margin-bottom: 16px; }
.book-cover-title em { font-style: normal; color: var(--accent-warm); }
.book-cover-subtitle { font-family: var(--font-serif); font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin: 24px auto 36px; max-width: 620px; }
.book-cover-meta { font-family: var(--font); font-size: 0.78rem; color: var(--text-muted); letter-spacing: 0.04em; }
.book-cover-meta span { margin: 0 8px; }
.book-cover-divider { width: 60px; height: 2px; background: var(--accent-warm); margin: 28px auto; }

.book-layout { display: grid; grid-template-columns: 260px 1fr; max-width: 1180px; margin: 0 auto; padding: 0 24px; gap: 0; }
.toc-sidebar { position: sticky; top: 48px; height: calc(100vh - 48px); overflow-y: auto; padding: 40px 24px 40px 0; border-right: 1px solid var(--border-light); }
.toc-title { font-family: var(--font); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-warm); margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
.toc-part { font-family: var(--font); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin: 24px 0 8px; padding-top: 16px; border-top: 1px dashed var(--border-light); }
.toc-part:first-of-type { padding-top: 0; border-top: none; }
.toc-part-title { font-family: var(--font-serif); font-size: 0.78rem; color: var(--text-secondary); margin-bottom: 8px; line-height: 1.5; }
.toc-list { list-style: none; }
.toc-list li { margin: 6px 0; }
.toc-list a { display: block; color: var(--text-secondary); font-size: 0.78rem; line-height: 1.5; padding: 4px 8px; border-left: 2px solid transparent; transition: all 0.15s; }
.toc-list a:hover { color: var(--accent-warm); border-left-color: var(--accent-warm); background: var(--accent-muted); text-decoration: none; }
.toc-list .toc-num { display: inline-block; min-width: 32px; font-family: var(--font); font-size: 0.7rem; color: var(--text-muted); }

.book-main { padding: 60px 0 80px 60px; max-width: 760px; }
.chapter-section { margin-bottom: 80px; padding-bottom: 64px; border-bottom: 1px solid var(--border); }
.chapter-section:last-child { border-bottom: none; }
.chapter-number-label { font-family: var(--font); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; color: var(--accent-warm); text-transform: uppercase; margin-bottom: 12px; }
.chapter-title { font-family: var(--font-serif); font-size: 1.85rem; font-weight: 700; line-height: 1.45; letter-spacing: 0.015em; color: var(--text); margin-bottom: 36px; }
.article-h2 { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 700; line-height: 1.5; letter-spacing: 0.01em; color: var(--text); margin: 56px 0 22px; padding-top: 24px; border-top: 2px solid var(--accent-warm); }
.article-h3 { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 700; line-height: 1.5; color: var(--text); margin: 36px 0 14px; padding-left: 14px; border-left: 3px solid var(--accent-warm); }
.book-main p { font-family: var(--font-serif); font-size: 1rem; line-height: 1.95; letter-spacing: 0.025em; color: var(--text); margin-bottom: 1.4em; text-indent: 1em; }
.book-main p:first-of-type, .book-main p.no-indent { text-indent: 0; }
.book-main p strong { font-weight: 700; color: var(--accent-warm); }
.epigraph { font-family: var(--font-serif); font-style: italic; color: var(--text-secondary); border-left: 3px solid var(--accent-warm); padding: 18px 24px; margin: 28px 0 36px; background: var(--accent-muted); }
.epigraph p { font-family: var(--font-serif); margin-bottom: 8px; line-height: 1.85; text-indent: 0; }
.epigraph .attribution { font-family: var(--font); font-size: 0.8rem; font-style: normal; color: var(--text-muted); letter-spacing: 0.05em; }
.pullquote { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; color: var(--accent-warm); border-left: 4px solid var(--accent-warm); padding: 16px 24px; margin: 32px 0; background: var(--accent-muted); line-height: 1.75; text-indent: 0; }
.table-clean { width: 100%; border-collapse: collapse; margin: 24px 0; font-family: var(--font); font-size: 0.86rem; }
.table-clean th { background: var(--surface); padding: 12px; text-align: left; border-bottom: 2px solid var(--accent-warm); font-weight: 700; }
.table-clean td { padding: 10px 12px; border-bottom: 1px solid var(--border-light); vertical-align: top; }
.finding-box { background: var(--surface); border-left: 4px solid var(--accent-warm); padding: 20px 24px; margin: 28px 0; font-family: var(--font-serif); }
.finding-box p { text-indent: 0; }

[data-theme="dark"] svg text { fill: #F0F0F0 !important; }
[data-theme="dark"] svg text[fill="#CC1400"] { fill: #FF5A4A !important; }
[data-theme="dark"] svg text[fill="#121212"] { fill: #F0F0F0 !important; }
[data-theme="dark"] svg text[fill="#555"], [data-theme="dark"] svg text[fill="#555555"] { fill: #CCCCCC !important; }
[data-theme="dark"] svg text[fill="#6B6B6B"] { fill: #AAAAAA !important; }
[data-theme="dark"] svg rect[fill="#FFF"], [data-theme="dark"] svg rect[fill="#FFFFFF"], [data-theme="dark"] svg rect[fill="white"] { fill: #333333 !important; }
[data-theme="dark"] svg rect[fill="#F7F7F5"] { fill: #2A2A2A !important; }
[data-theme="dark"] svg circle[fill="#FFF"], [data-theme="dark"] svg circle[fill="#FFFFFF"], [data-theme="dark"] svg circle[fill="white"] { fill: #333333 !important; stroke: #FF5A4A !important; }
[data-theme="dark"] svg rect[stroke="#121212"] { stroke: #F0F0F0 !important; }
[data-theme="dark"] svg rect[stroke="#D9D9D9"] { stroke: #666666 !important; }
[data-theme="dark"] svg rect[stroke="#CC1400"] { stroke: #FF5A4A !important; }
[data-theme="dark"] svg line[stroke="#121212"] { stroke: #F0F0F0 !important; }
[data-theme="dark"] svg line[stroke="#999"] { stroke: #888888 !important; }
[data-theme="dark"] svg line[stroke="#CC1400"] { stroke: #FF5A4A !important; }
[data-theme="dark"] svg polygon[fill="#121212"] { fill: #F0F0F0 !important; }
[data-theme="dark"] svg circle[fill="#CC1400"] { fill: #FF5A4A !important; }
[data-theme="dark"] svg path[stroke="#CC1400"] { stroke: #FF5A4A !important; }
[data-theme="dark"] figure[style] { background: rgba(255,90,74,0.06) !important; border-top-color: #FF5A4A !important; border-bottom-color: #FF5A4A !important; }
[data-theme="dark"] figcaption { color: #AAAAAA !important; }

@media print { .top-bar, .toc-sidebar { display: none; } .book-layout { grid-template-columns: 1fr; } .book-main { padding: 0; max-width: none; } }
@media (max-width: 1000px) { .book-layout { grid-template-columns: 1fr; } .toc-sidebar { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--border); padding: 24px 0; } .book-main { padding: 40px 0; } .book-cover-title { font-size: 2rem; } }
</style>
</head>
